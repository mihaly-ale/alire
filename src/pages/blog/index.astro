---
// components import
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
import BreadcrumbNavigation from '../../components/BreadcrumbNavigation.astro';
import { BreadcrumbsItem } from 'accessible-astro-components';

// utility import
import { getCollection } from 'astro:content';
import slugify from '@sindresorhus/slugify';

const blogPosts = await getCollection('blog');
const headline = 'Mi Blog';
---

<SecondaryLayout headline={headline} title="Alire">
	<div class="secondary-page-content">
		<h1>{headline}</h1>

		<BreadcrumbNavigation>
			<BreadcrumbsItem href={`${import.meta.env.BASE_URL}`} label="Inicio" />
			<BreadcrumbsItem label="Blog" currentPage={true} />
		</BreadcrumbNavigation>

		<main>
			<ul>
				{
					blogPosts.map((post) => (
						<li class="container">
							<h2 class="blog-title">
								<a
									href={`${import.meta.env.BASE_URL}/blog/${slugify(post.data.title)}`}>
									{post.data.title} - {post.data.subtitle}
								</a>
							</h2>

							<small>
								<p>
									<a
										href={`${import.meta.env.BASE_URL}/blog/autor/${slugify(post.data.author)}`}
										class="author">
										{post.data.author}
									</a>
									&nbsp;&middot;
									{new Date(post.data.publishedDate).toLocaleDateString(
										'es-ES',
										{
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										}
									)}
								</p>
								<ul class="categories">
									{post.data.categories.map((category) => (
										<li>
											<a
												href={`${import.meta.env.BASE_URL}/blog/categoria/${slugify(category)}`}
												class="category">
												{category}
											</a>
										</li>
									))}
								</ul>
							</small>

							<img
								src={post.data.image.src.src}
								alt={post.data.image.alt}
								width={post.data.image.src.width}
								height={post.data.image.src.height}
								aria-hidden="true"
								decoding="async"
								loading="eager"
								class="blog-image"
							/>

							<p class="blog-excerpt">{post.body.split('##')[0]}</p>
							<a
								class="btn btn-secondary"
								href={`${import.meta.env.BASE_URL}/blog/${slugify(post.data.title)}`}>
								Saber más
							</a>
							<img
								class="page-motif"
								src={`${import.meta.env.BASE_URL}/logos/motif-dark.svg`}
								alt=""
							/>
						</li>
					))
				}
			</ul>
		</main>
	</div>
</SecondaryLayout>
