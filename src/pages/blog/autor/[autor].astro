---
// components import
import SecondaryLayout from '../../../layouts/SecondaryLayout.astro';
import BreadcrumbNavigation from '../../../components/BreadcrumbNavigation.astro';
import { BreadcrumbsItem } from 'accessible-astro-components';

// utility import
import { getCollection } from 'astro:content';
import slugify from '@sindresorhus/slugify';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog');

	return blogEntries.map((entry) => {
		return {
			params: { autor: slugify(entry.data.author) },
			props: { author: entry.data.author, blogEntries },
		};
	});
}

const { author, blogEntries } = Astro.props;

const filteredPosts = blogEntries.filter(
	(entry) => entry.data.author === author
);
---

<SecondaryLayout headline=`Entradas de ${author}` title="Blog | Alire">
	<div class="secondary-page-content">
		<BreadcrumbNavigation>
			<BreadcrumbsItem href={`${import.meta.env.BASE_URL}`} label="Inicio" />
			<BreadcrumbsItem href={`${import.meta.env.BASE_URL}/blog`} label="Blog" />
			<BreadcrumbsItem label={author} currentPage={true} />
		</BreadcrumbNavigation>

		<main>
			<h1>Entradas de {author}</h1>

			<ul>
				{
					filteredPosts.map((post) => (
						<li class="container">
							<h2 class="blog-title">
								<a
									href={`${import.meta.env.BASE_URL}/blog/${slugify(post.data.title)}`}>
									{post.data.title} - {post.data.subtitle}
								</a>
							</h2>

							<small>
								<p>
									{new Date(post.data.publishedDate).toLocaleDateString(
										'es-ES',
										{
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										}
									)}
								</p>

								<ul class="categories">
									{post.data.categories.map((category) => (
										<li>
											<a
												href={`${import.meta.env.BASE_URL}/blog/categoria/${slugify(category)}`}
												class="category">
												{category}
											</a>
										</li>
									))}
								</ul>
							</small>

							<p class="blog-excerpt">{post.body.split('##')[0]}</p>

							<a
								class="btn btn-secondary"
								href={`${import.meta.env.BASE_URL}/blog/${slugify(post.data.title)}`}>
								Saber más
							</a>

							<img
								class="page-motif"
								src={`${import.meta.env.BASE_URL}/logos/motif-dark.svg`}
								alt=""
							/>
						</li>
					))
				}
			</ul>
		</main>
	</div>
</SecondaryLayout>
